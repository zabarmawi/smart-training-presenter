<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget><AssemblyName>SmartTrainingPresenter</AssemblyName>
    <Version>0.6.1</Version><AssemblyVersion>0.6.1.16</AssemblyVersion><FileVersion>0.6.1.16</FileVersion>
    <InformationalVersion>0.6.1 Build 16 Windows x64</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Content Include="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" /><Content Include="Resources\*.pdf" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
